# Gemini API key. REQUIRED. Read directly by the google-genai SDK underneath
# every LlmAgent call (Director, Location, Scheduler, Budget, Risk, Report) —
# it is never read via os.getenv() in this codebase, the SDK picks it up from
# the environment itself. Without it, every agent call fails with an auth
# error. Get one at https://aistudio.google.com/app/apikey.
GOOGLE_API_KEY=your-gemini-api-key

# Parallel Search API key. REQUIRED for the Location Agent. Read in
# backend/app/services/parallel_search.py — search_location_candidates()
# raises RuntimeError("PARALLEL_API_KEY is missing.") immediately if unset,
# so POST /api/v1/locations/search fails outright. Every other endpoint
# (script analysis, scheduling, budget, risk, report) works without it.
PARALLEL_API_KEY=your-parallel-api-key

# Mapbox access token. OPTIONAL. Read in backend/app/services/geocoding.py —
# used only as a fallback geocoder when Nominatim (OpenStreetMap, free, no
# key required) fails to resolve a location's coordinates. If unset,
# geocode_with_mapbox() returns None silently and that location is simply
# left without coordinates on the map; nothing errors.
MAPBOX_TOKEN=your-mapbox-token

# Model used by every LlmAgent (Director, Location, Scheduler, Budget, Risk,
# Report), via backend/app/config/settings.py. OPTIONAL — defaults to
# "gemini-3.5-flash" (full quality) if unset.
GEMINI_MODEL=gemini-3.5-flash

# Cheaper option for development/testing: gemini-2.5-flash-lite is roughly
# 10-15x cheaper per Google's pricing (as of September 2026), but quality
# may be lower, especially for agents that need to catch subtle rule
# violations (Location, Scheduler, Budget, Risk).
# GEMINI_MODEL=gemini-2.5-flash-lite

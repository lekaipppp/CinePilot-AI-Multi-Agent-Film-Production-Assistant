# Model used by every LlmAgent (Director, Location, Scheduler, Budget, Risk).
# Default: full quality, used for real submissions/demos.
GEMINI_MODEL=gemini-3.5-flash

# Cheaper option for development/testing: gemini-2.5-flash-lite is roughly
# 10-15x cheaper per Google's pricing (as of September 2026), but quality
# may be lower, especially for agents that need to catch subtle rule
# violations (Location, Scheduler, Budget, Risk).
# GEMINI_MODEL=gemini-2.5-flash-lite

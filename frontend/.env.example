# Base URL of the backend API, read in every frontend/lib/*-api.ts file.
# OPTIONAL — defaults to http://localhost:8000/api/v1 if unset, which is
# correct for running the backend locally with the repo's Procfile/uvicorn
# command. Only needs to change when pointing at a deployed backend.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

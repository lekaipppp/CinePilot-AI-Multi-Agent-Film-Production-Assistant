# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# ──────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────
APP_NAME="CinePilot AI"
APP_VERSION="0.1.0"

# "development" | "staging" | "production"
ENV=development

# Set to true for verbose SQL + coloured log output
DEBUG=false

# "DEBUG" | "INFO" | "WARNING" | "ERROR" | "CRITICAL"
# Automatically set to DEBUG when DEBUG=true
LOG_LEVEL=INFO

# Set to false in production to hide /docs and /redoc
DOCS_ENABLED=true

# ──────────────────────────────────────────────
# Security
# ──────────────────────────────────────────────
SECRET_KEY="SECRET_KEY=vJ9#cP2!xLm7@Qz5Rn8$Ws4Ty1Kb6Hd"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated allowed Host header values (production reverse proxy)
# TRUSTED_HOSTS=["api.cinepilot.ai","www.cinepilot.ai"]

# ──────────────────────────────────────────────
# Database (Supabase PostgreSQL)
# ──────────────────────────────────────────────
DATABASE_URL="postgresql+asyncpg://postgres.fsgztdodluowshjuuiyn:Cinema%401422111@aws-1-ap-south-1.pooler.supabase.com:5432/postgres"
# ──────────────────────────────────────────────
# CORS
# ──────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# ──────────────────────────────────────────────
# Google / Gemini
# ──────────────────────────────────────────────
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-pro"
GOOGLE_MAPS_API_KEY=""
GOOGLE_PLACES_API_KEY=""

# ──────────────────────────────────────────────
# OpenWeather
# ──────────────────────────────────────────────
OPENWEATHER_API_KEY=""
